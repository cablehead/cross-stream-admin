#!/usr/bin/env bash
# ce-site-deploy <label>   -- run as root, once per push, by post-receive.
#
# Reads a tar of the pushed tree on stdin and lands it as the site: rebuild repo/, resolve the
# manifest into http-nu flags, ensure the persistent dirs, write env, enable and restart.
#
# Why one script rather than the nine sudo calls this replaces: every sudo session writes three
# pam lines to the journal (open, the pam_env notice, close), so a single push wrote about
# thirty lines of session bookkeeping around nine lines of actual work, and the git-host log was
# unreadable at a glance. One sudo per push means one COMMAND line and one session.
#
# The label still gets validated here even though the caller derived it from a bare-repo name
# the admin created. This runs as root off a stdin stream; it should not take the caller's word
# for where to write.
set -euo pipefail

LABEL=${1:?usage: ce-site-deploy <label>}
case "$LABEL" in
  admin | www | placeholder | git)
    echo "ce-site-deploy: refusing reserved label '$LABEL'" >&2; exit 2 ;;
esac
[[ "$LABEL" =~ ^[a-z0-9][a-z0-9-]{0,31}$ ]] || { echo "ce-site-deploy: bad label '$LABEL'" >&2; exit 2; }

SITE=/home/app/sites/$LABEL
WORKTREE=$SITE/repo
STORE_DIR=$SITE/store
STATE_DIR=$SITE/state

# Wipe first so files deleted in the push do not linger. Only repo/ is rebuilt; the persistent
# dirs below are left alone.
rm -rf "$WORKTREE"
mkdir -p "$WORKTREE"
tar -x -C "$WORKTREE" -f -
# Scoped to the work-tree on purpose: it is what the push just rebuilt, and the only thing whose
# modes should be normalised here.
chmod -R a+rX "$WORKTREE"

if [ ! -f "$WORKTREE/serve.nu" ]; then
  echo "post-receive: WARNING no serve.nu at repo root, site@$LABEL will fail to start"
fi

# --- opt-in http-nu features from the repo manifest (cross-stream.nuon) --------
# A repo declares INTENT as booleans; everything is off by default. We read only the known
# booleans and build the flag string ourselves (paths are ours), so a pushed repo can never
# inject raw args like --expose / --tls / -c / --plugin. `open` on a .nuon file is data
# deserialization, not evaluation, so it is safe.
MANIFEST="$WORKTREE/cross-stream.nuon"
flags=""
if [ -f "$MANIFEST" ]; then
  flags=$(MANIFEST="$MANIFEST" STORE_DIR="$STORE_DIR" /usr/local/bin/nu -n -c '
    let m = (try { open ($env.MANIFEST) } catch { {} })
    let services = (($m | get -o services | default false) == true)
    let store = ((($m | get -o store | default false) == true) or $services)
    mut f = []
    if $store { $f = ($f | append $"--store ($env.STORE_DIR)") }
    if $services { $f = ($f | append "--services") }
    if (($m | get -o datastar | default false) == true) { $f = ($f | append "--datastar") }
    $f | str join " "
  ' 2>/dev/null || true)
fi

# The store must survive redeploys (we only wipe repo/) and be writable by the site's group:
# root-owned, group `sites`, setgid so frames inherit the group.
if [[ "$flags" == *"--store"* ]]; then
  install -d -m 2770 -g sites "$STORE_DIR"
fi

# state/ is the same deal but unconditional: every site gets one writable, redeploy-surviving
# directory, with no manifest opt-in and no coupling to the event store. It is the only place a
# site can put a SQLite file, a cache, uploads, anything it writes itself. We create it here,
# because the sandboxed site cannot make one for itself.
install -d -m 2770 -g sites "$STATE_DIR"

# Hand the flags to systemd via the unit's EnvironmentFile (empty = no flags).
# CROSS_STREAM_SITE_STATE lands in the site's environment too, so a handler reaches its state
# dir as $env.CROSS_STREAM_SITE_STATE rather than hard-coding a path that embeds its own label.
{ printf 'HTTPNU_FLAGS=%s\n' "$flags"; printf 'CROSS_STREAM_SITE_STATE=%s\n' "$STATE_DIR"; } \
  > "$SITE/env"
echo "post-receive: http-nu flags for $LABEL: ${flags:-<none>}"

# enable, not just restart: a pushed site must survive a reboot. restart alone leaves the unit
# running but not wanted-by multi-user.target, so the next VM reboot drops it. enable creates
# the persistent want; restart picks up the code just pushed. Idempotent on re-push.
systemctl enable "site@$LABEL" 2>/dev/null
systemctl restart "site@$LABEL"
echo "post-receive: enabled + restarted site@$LABEL"
